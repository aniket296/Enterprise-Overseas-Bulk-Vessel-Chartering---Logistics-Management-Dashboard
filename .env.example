# ============================================================
# .env.example — SIH26006 Logistics Dashboard
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# ============================================================

# ----- PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipping_dev
DB_USER=shipping_user
DB_PASSWORD=shipping_dev_secret

# ----- Django (added in Phase 2) -----
# DJANGO_SECRET_KEY=change-me-to-50-random-chars
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=localhost,127.0.0.1

# ----- Redis / Celery (added in Phase 2) -----
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ----- MinIO (added in Phase 4) -----
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_USE_HTTPS=False
# MINIO_BUCKET_DOCUMENTS=shipping-documents
