# ==============================================================================
# .env.example — Enterprise Overseas Bulk Vessel Logistics Management Dashboard
# Problem Statement: SIH26006 (Steel Authority of India Limited / Ministry of Steel)
#
# Copy this file to .env and configure local secret values before running.
# NEVER commit .env to version control.
# ==============================================================================

# ----- PostgreSQL Database -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vessel_chartering_db
POSTGRES_USER=shipping_user
POSTGRES_PASSWORD=shipping_dev_secret

# ----- Django Web Framework -----
DJANGO_SECRET_KEY=sih26006-enterprise-vessel-logistics-secret-key-prod-32chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ----- Redis / Celery Async Broker -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# ----- MinIO Document Vault (S3 Compatible) -----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_HTTPS=False
MINIO_BUCKET_DOCUMENTS=shipping-documents

# ----- Frontend (Next.js) -----
PORT=3000
INTERNAL_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=/api/v1
